# Copy this file to .env.local and fill in your values

# ─── Zoho OAuth (India DC) ───────────────────────────────────────────────────
# These are NEXT_PUBLIC because they're embedded at build time (static export)
NEXT_PUBLIC_ZOHO_CLIENT_ID=your_client_id_here

# Local development
NEXT_PUBLIC_ZOHO_REDIRECT_URI=http://localhost:3013/auth/zoho/callback

# ─── Zoho Catalyst Slate (India DC) — set in Slate dashboard ─────────────────
# NEXT_PUBLIC_ZOHO_REDIRECT_URI=https://rover-vusuhtjq.onslate.in/auth/zoho/callback
