# Copy this file to .env.local and fill in your values

# ─── Zoho OAuth (India DC) ───────────────────────────────────────────────────
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here   # optional if using implicit flow

# ─── Local development ────────────────────────────────────────────────────────
ZOHO_REDIRECT_URI=http://localhost:3013/api/auth/zoho/callback
NEXT_PUBLIC_APP_URL=http://localhost:3013

# ─── Zoho Catalyst Slate (India DC) — set these in the Slate dashboard ───────
# ZOHO_REDIRECT_URI=https://rover-vusuhtjq.onslate.in/api/auth/zoho/callback
# NEXT_PUBLIC_APP_URL=https://rover-vusuhtjq.onslate.in
